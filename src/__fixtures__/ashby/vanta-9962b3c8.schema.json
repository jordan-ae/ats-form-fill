              "path": "a4505c23-d9cc-41f1-90f8-3c1a93387c43",
              "humanReadablePath": "",
              "title": "Scaling experience",
              "isNullable": false,
              "isPrivate": false,
              "isDeactivated": false,
              "isMany": false,
              "metadata": {},
              "type": "LongText",
              "__autoSerializationID": "LongTextField"
            },
            "fieldValue": null,
            "isRequired": true,
            "descriptionHtml": "<p><strong>Tell us about a system you helped evolve as a company or product grew rapidly. What was no longer working, what did you change, and how did you know the new approach would scale?</strong></p>",
            "isHidden": null
          },
          {
            "__typename": "FormFieldEntry",
